<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1050.0" prefHeight="560.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.maquinaria.controlador.MaquinariaController">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
    <top>
        <Label text="Arriendo de Maquinaria — Registro de equipos"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </top>
    <center>
        <HBox spacing="18">
            <padding><Insets top="12" bottom="12"/></padding>
            <VBox prefWidth="320" spacing="10">
                <Label text="Datos de la máquina" style="-fx-font-weight: bold;"/>
                <GridPane hgap="8" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="115"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Tipo" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbTipo" onAction="#cambiarTipo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Código" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Horas de uso" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtHorasUso" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Potencia (HP)" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtPotencia" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
                <Separator/>
                <Label fx:id="lblSeccionEspecifica" text="Datos de la excavadora" style="-fx-font-weight: bold;"/>
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="115"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label fx:id="lblDetalle" text="Peso (ton)" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtDetalle" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <CheckBox fx:id="chkMantencion" text="Mantención al día" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkCertificacion" text="Certificación de seguridad" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
                <HBox spacing="8">
                    <Button fx:id="btnRegistrar" text="Registrar" onAction="#registrar" prefWidth="130"/>
                    <Button fx:id="btnCancelarEdicion" text="Cancelar edición" onAction="#cancelarEdicion" disable="true"/>
                </HBox>
            </VBox>
            <VBox spacing="9" HBox.hgrow="ALWAYS">
                <Label text="Máquinas registradas" style="-fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <TextField fx:id="txtBuscar" promptText="Buscar por código" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#buscar"/>
                    <Button text="Mostrar todos" onAction="#mostrarTodos"/>
                </HBox>
                <TableView fx:id="tablaMaquinas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="columnaId" text="ID" prefWidth="45">
                            <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="120">
                            <cellValueFactory><PropertyValueFactory property="tipo"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaCodigo" text="Código" prefWidth="90">
                            <cellValueFactory><PropertyValueFactory property="codigo"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaHorasUso" text="Horas" prefWidth="65">
                            <cellValueFactory><PropertyValueFactory property="horasUso"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaPotencia" text="Potencia" prefWidth="75">
                            <cellValueFactory><PropertyValueFactory property="potencia"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaDetalle" text="Detalle" prefWidth="210">
                            <cellValueFactory><PropertyValueFactory property="detalle"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="columnaCosto" text="Costo ($)" prefWidth="90">
                            <cellValueFactory><PropertyValueFactory property="costoServicio"/></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button fx:id="btnEditar" text="Editar" onAction="#editarSeleccionado"/>
                    <Button text="Eliminar" onAction="#eliminarSeleccionado"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <Label fx:id="lblMensaje" text="Sistema listo." maxWidth="Infinity" wrapText="true"
               style="-fx-padding: 9; -fx-background-color: #edf6ec; -fx-text-fill: #247a3b; -fx-font-weight: bold;"/>
    </bottom>
</BorderPane>
